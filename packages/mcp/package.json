{
  "name": "@earnforge/mcp",
  "version": "1.0.0",
  "type": "module",
  "license": "Apache-2.0",
  "description": "Earn-native MCP server for the LI.FI Earn API — 11 tools for vault discovery, risk scoring, allocation, and deposit quoting",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.mts",
        "default": "./dist/esm/index.mjs"
      }
    },
    "./worker": {
      "import": {
        "types": "./dist/esm/worker.d.mts",
        "default": "./dist/esm/worker.mjs"
      }
    }
  },
  "bin": {
    "earnforge-mcp": "./dist/esm/index.mjs"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "generate": "tsx scripts/generate-skill-content.ts",
    "build": "pnpm generate && tsdown src/index.ts src/worker.ts --format esm --dts --out-dir dist/esm",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "@earnforge/sdk": "workspace:*",
    "@modelcontextprotocol/server": "^2.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.0.0",
    "@types/node": "^25.6.0",
    "tsdown": "^0.22.14",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
