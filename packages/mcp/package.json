{
  "name": "@earnforge/mcp",
  "version": "1.0.4",
  "type": "module",
  "license": "Apache-2.0",
  "author": "Farseen Shaikh",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FarseenSh/earnforge.git",
    "directory": "packages/mcp"
  },
  "homepage": "https://earnforge-docs.vercel.app",
  "bugs": {
    "url": "https://github.com/FarseenSh/earnforge/issues"
  },
  "description": "Earn-native MCP server for the LI.FI Earn API — 12 tools for vault discovery, risk scoring, allocation, and deposit quoting",
  "keywords": [
    "lifi",
    "earn",
    "defi",
    "yield",
    "vaults",
    "mcp",
    "model-context-protocol",
    "ai-agent"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.mts",
        "default": "./dist/esm/index.mjs"
      }
    },
    "./worker": {
      "import": {
        "types": "./dist/esm/worker.d.mts",
        "default": "./dist/esm/worker.mjs"
      }
    }
  },
  "bin": {
    "earnforge-mcp": "./dist/esm/index.mjs"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "generate": "tsx scripts/generate-skill-content.ts",
    "build": "pnpm generate && tsdown src/index.ts src/worker.ts --format esm --dts --out-dir dist/esm",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "@earnforge/sdk": "workspace:^",
    "@modelcontextprotocol/server": "^2.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.0.0",
    "@types/node": "^25.6.0",
    "tsdown": "^0.22.14",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
