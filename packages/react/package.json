{
  "name": "@earnforge/react",
  "version": "1.0.0",
  "type": "module",
  "license": "Apache-2.0",
  "author": "Farseen Shaikh",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FarseenSh/earnforge.git",
    "directory": "packages/react"
  },
  "homepage": "https://earnforge-docs.vercel.app",
  "bugs": {
    "url": "https://github.com/FarseenSh/earnforge/issues"
  },
  "description": "React hooks for the LI.FI Earn API — vault discovery, risk scoring, yield strategies, and deposits",
  "keywords": [
    "lifi",
    "earn",
    "defi",
    "yield",
    "vaults",
    "react",
    "hooks",
    "wagmi",
    "viem"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.mts",
        "default": "./dist/esm/index.mjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsdown src/index.ts --format esm --dts --out-dir dist/esm",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "@earnforge/sdk": "workspace:*"
  },
  "peerDependencies": {
    "@tanstack/react-query": ">=5.90.0",
    "react": ">=19",
    "viem": "^2.47.11",
    "wagmi": ">=3.0.0"
  },
  "devDependencies": {
    "@tanstack/react-query": "^5.90.0",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "jsdom": "^26.1.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "tsdown": "^0.22.14",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
