{
  "name": "@earnforge/cli",
  "version": "1.0.0",
  "type": "module",
  "license": "Apache-2.0",
  "description": "CLI for the LI.FI Earn API — vault discovery, risk scoring, deposit and withdrawal quoting, and API diagnostics",
  "bin": {
    "earnforge": "./dist/esm/bin.mjs"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.mts",
        "default": "./dist/esm/index.mjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsdown src/bin.ts src/index.ts --format esm --dts --out-dir dist/esm",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "@earnforge/sdk": "workspace:*",
    "chalk": "^5.4.1",
    "cli-table3": "^0.6.5",
    "commander": "^15.0.0",
    "ora": "^8.2.0"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "tsdown": "^0.22.14",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
