{
  "name": "earnforge",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "verify": "pnpm turbo build && pnpm turbo typecheck && pnpm check && pnpm turbo test",
    "verify:live": "pnpm --filter @earnforge/sdk test:live && pnpm --filter @earnforge/sdk drift",
    "build": "turbo run build",
    "check": "biome check .",
    "check:fix": "biome check --fix .",
    "test": "turbo run test",
    "test:unit": "turbo run test:unit",
    "test:live": "turbo run test:live",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "typecheck": "turbo run typecheck",
    "circular": "turbo run circular",
    "clean": "turbo run clean",
    "prepare": "husky"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.11",
    "@changesets/cli": "^3.0.1",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@types/node": "^26.4.1",
    "husky": "^9.1.7",
    "knip": "^6.34.0",
    "turbo": "^2.10.8",
    "typescript": "^7.0.2"
  }
}
